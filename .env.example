# =============================================================================
# Environment Variables - Template
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# NEVER commit .env.local to version control!
# =============================================================================

# --- Next.js -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME={{PROJECT_NAME}}

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# The Supabase schema used by the application: "public" (production, default) or
# "public_preview" (preview environments, see HOWTO section 3). Allowed values only; anything else
# fails the build. next.config.ts passes it to server, proxy and browser as NEXT_PUBLIC_DB_SCHEMA;
# it also selects the storage buckets (belege vs. belege-preview) and is read by the Node scripts.
# The schema must be listed in Supabase → Project Settings → API → Exposed schemas.
# The GitHub deploy workflow (db_schema input) can override it via NEXT_PUBLIC_DB_SCHEMA.
SUPABASE_DB_SCHEMA=public

# --- AI assistant ---------------------------------------------------------------
# Secret used to encrypt provider API keys at rest (AES-256-GCM, src/lib/ai/schluessel.ts).
# Any long random string; without it the AI assistant cannot decrypt the stored provider key.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KI_ANBIETER_SCHLUESSEL=

# --- Speech (dictation and read-aloud) --------------------------------------
# Bearer token for the Sokrates API, which serves both directions:
#   POST /audio/transcriptions (speech to text) and POST /audio/speech (text to speech).
# Without it the buttons are visible but every call fails with a clear message.
# The same value belongs in Vercel Production.
KI_SOKRATES_API_SCHLUESSEL=
# Optional overrides - only needed to point at a different service (e.g. a
# self-hosted one on the office LAN). Defaults target the Sokrates API.
# KI_TRANSKRIPTION_URL=
# KI_SPRACHAUSGABE_URL=
# Optional: Cloudflare Access service token, used only when no bearer token is
# set (secondary path, kept for a self-hosted service behind a tunnel).
# KI_TRANSKRIPTION_ACCESS_ID=
# KI_TRANSKRIPTION_ACCESS_SECRET=
# Dictation stops by itself once the speaker goes quiet. These two knobs are
# the ones that need tuning against a real workplace: a noisy yard needs a
# higher level, someone who pauses to think needs a longer wait. Defaults are
# 0.02 and 1200 ms (src/lib/domain/diktat.ts). NEXT_PUBLIC_, so they are baked
# in at build time - changing them needs a redeploy. Values outside the
# allowed range are ignored and the defaults apply.
# --- Speech recognition provider --------------------------------------------
# Which service turns speech into text. "whisper" (default) = our own model on
# Caesar. "soniox" = the external service; on failure, timeout or a missing
# key it falls back to Whisper automatically, so nobody loses dictation.
# KI_SPRACHERKENNUNG_ANBIETER=whisper
# Where Soniox processes the audio. No default in code on purpose: the data
# location is an operations decision and it moves (demo: US, pilot: EU,
# customer: Kazakhstan). Without this the Soniox path does not start at all.
# SONIOX_API_URL=https://api.soniox.com
# Key for Soniox. Environment only - never in code, logs or a PR.
# SONIOX_API_KEY=
# Optional: how long Soniox may take. Default 20000 ms. This is not a wait:
# after 6 s Whisper runs alongside it and the first usable text wins
# (src/lib/domain/spracherkennung.ts). Worst case 6 + 20 = 26 s, cap 40 s.
# SONIOX_ZEITLIMIT_MS=20000

# --- Live dictation -----------------------------------------------------------
# Text appears in the input field WHILE speaking: the browser streams straight
# to Soniox (stt-rt-v5, WebSocket) with a short-lived key minted per recording
# by /api/ki-spracherkennung; the real SONIOX_API_KEY never leaves the server.
# The model detects the end of the utterance itself. Needs SONIOX_API_KEY and
# SONIOX_API_URL (above). Off by default; turning it off is the rollback -
# dictation then uploads the whole recording as before. If anything in the
# live path fails, the same recording is sent the old way automatically.
#   aus / off  - file upload (today's behaviour)
#   an  / on   - live dictation
# KI_DIKTAT_LIVE=aus
# Optional: WebSocket address, only if it cannot be derived from
# SONIOX_API_URL (api.eu.soniox.com -> wss://stt-rt.eu.soniox.com/...).
# SONIOX_STT_WS_URL=

# --- Read-aloud provider ------------------------------------------------------
# Who speaks the answers.
#   sokrates (default) - our voices on the Sokrates API (de/en/ru/kk-female)
#   soniox             - Soniox TTS v2 (tts-rt-v2), one voice for all four
#                        languages; Sokrates stays the automatic fallback.
# Uses SONIOX_API_KEY and the region from SONIOX_API_URL
# (api.eu.soniox.com -> https://tts-rt.eu.soniox.com).
# KI_SPRACHAUSGABE_ANBIETER=sokrates
# Optional: Soniox voice name (default Maya). An unknown name is rejected by
# Soniox, and the answer is read by Sokrates instead - visible in the log.
# SONIOX_TTS_STIMME=Maya
# Optional: TTS address, only if it cannot be derived from SONIOX_API_URL.
# SONIOX_TTS_URL=

# --- Live read-aloud --------------------------------------------------------
# Reads an answer out sentence by sentence while it is still being written,
# instead of waiting for the whole text. Off by default; turning it off is the
# rollback.
#   aus / off  - only the per-answer read-aloud button (today's behaviour)
#   an  / on   - sections are spoken as they appear
# KI_SPRACHAUSGABE_LIVE=aus
# Secret that signs each section (HMAC-SHA256). REQUIRED when the switch is on:
# without it live read-aloud stays off rather than running unprotected, because
# the route would otherwise read out any text anyone signed in sends it.
# Any long random string, at least 16 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KI_SPRACHAUSGABE_SIGNATUR=

# --- Agent side view --------------------------------------------------------
# When the agent navigates for the first time, the panel docks to the side and
# STAYS there (across further questions, stops and a reload). Off by default;
# turning it off is the rollback.
#   aus / off  - the panel keeps today's behaviour (back to the centre)
#   an  / on   - the agent switches to the side view and stays
# KI_AGENT_SEITENANSICHT=aus

# NEXT_PUBLIC_DIKTAT_STILLE_PEGEL=0.02
# NEXT_PUBLIC_DIKTAT_STILLE_MS=1200

# --- Optional: Additional Services ------------------------------------------
# NEXT_PUBLIC_GA_TRACKING_ID=
# RESEND_API_KEY=
