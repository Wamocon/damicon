language" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;;" vertex="1" parent="1"><mxGeometry x="370" y="250" width="240" height="56" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;3&lt;/b&gt;  guardrails, prompt, tool set&lt;br&gt;for this role and mode" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;;" vertex="1" parent="1"><mxGeometry x="680" y="330" width="240" height="56" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;4&lt;/b&gt;  Agent mode: step 0 must call&lt;br&gt;a tool (escape hatch: ohneAnsicht)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;;" vertex="1" parent="1"><mxGeometry x="680" y="410" width="240" height="56" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;5&lt;/b&gt;  decides: one tool per step,&lt;br&gt;in a sensible order, narrates" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;;" vertex="1" parent="1"><mxGeometry x="1300" y="410" width="240" height="56" as="geometry"/></mxCell><mxCell id="c19" value="LOOP   Claude picks one tool per step, every result goes back into the conversation   (max 12 steps, Agent mode 28)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#5f6368;strokeWidth=1.5;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontFamily=Helvetica;fontSize=12;fontSize=13;fontColor=#3c4043;" vertex="1" parent="1"><mxGeometry x="330" y="500" width="1240" height="550" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;A  Data and navigation&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontFamily=Helvetica;fontSize=12;fontSize=12;fontColor=#3c4043;" vertex="1" parent="1"><mxGeometry x="350" y="538" width="300" height="20" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;6a&lt;/b&gt;  server tool runs under the&lt;br&gt;user's session" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;;" vertex="1" parent="1"><mxGeometry x="680" y="566" width="240" height="56" as="geometry"/></mxCell><mxCell id="c22" value="rows this role may see, plus a&lt;br&gt;link to where they live" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;;" vertex="1" parent="1"><mxGeometry x="990" y="566" width="240" height="56" as="geometry"/></mxCell><mxCell id="c23" value="tour: the main window opens the&lt;br&gt;page, scrolls, highlights" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;;" vertex="1" parent="1"><mxGeometry x="370" y="566" width="240" height="56" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;B  Operate the page&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontFamily=Helvetica;fontSize=12;fontSize=12;fontColor=#3c4043;" vertex="1" parent="1"><mxGeometry x="350" y="640" width="300" height="20" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;6b&lt;/b&gt;  client tool: no server work,&lt;br&gt;the call streams to the browser" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;;" vertex="1" parent="1"><mxGeometry x="680" y="666" width="240" height="56" as="geometry"/></mxCell><mxCell id="c26" value="read, click, fill · cursor moves&lt;br&gt;safety gate applies" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;;" vertex="1" parent="1"><mxGeometr