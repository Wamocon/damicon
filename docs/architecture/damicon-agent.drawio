ex="1" parent="1"><mxGeometry x="60" y="140" width="440" height="62" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;KiChat&lt;/b&gt;  useChat + transport&lt;br&gt;streamed markdown · auto-scroll · live tool steps (click = jump to source)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;;" vertex="1" parent="1"><mxGeometry x="60" y="222" width="440" height="62" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Client tools&lt;/b&gt;  (execute in the browser)&lt;br&gt;seiteLesen · klicke · fuelleFeld · scrolleZu · zeigeAuf&lt;br&gt;page snapshot with element refs, required fields, formats" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;;" vertex="1" parent="1"><mxGeometry x="60" y="318" width="440" height="82" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Safety gate&lt;/b&gt;&lt;br&gt;blocked: sign-out, password fields, off-site links&lt;br&gt;confirm first: anything that submits or deletes&lt;br&gt;an unsent form is never reported as success" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="440" height="92" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Agent cursor + guided tour&lt;/b&gt;&lt;br&gt;visible cursor and click ripple · focus highlight&lt;br&gt;tour queue across pages · Stop button" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;;" vertex="1" parent="1"><mxGeometry x="60" y="530" width="440" height="78" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Approval card&lt;/b&gt;  (human in the loop)&lt;br&gt;Confirm / Decline before any action runs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;;" vertex="1" parent="1"><mxGeometry x="60" y="628" width="440" height="62" as="geometry"/></mxCell><mxCell id="c13" value="Roles with AI: admin · farm management · accounting · customer · field crew&lt;br&gt;No AI: picker · producer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#9aa0a6;;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="60" y="708" width="440" height="52" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br&gt;session · RBAC ki_assistent:create · consent&lt;br&gt;history capped (40 msgs), user/assistant roles only&lt;br&gt;role preview accepted for admins only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;;" vertex="1" parent="1"><mxGeometry x="580" y="140" width="500" height="92" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Prompt composer&lt;/b&gt;&lt;br&gt;4 sources: live data · the app · rules · general knowledge (labelled)&lt;br&gt;role scope · UI language · mode rules · evidence rule" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;;" vertex="1" parent="1"><mxGeometry x="580" y="252" width="500" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;AI SDK v7  streamText&lt;/b&gt;&lt;br&gt;prepareStep: toolChoice = required (agent) · stopWhen 12 / 28 steps&lt;br&gt;sequential tool calls · smoothStream · stale page snapshots pruned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;;" vertex="1" parent="1"><mxGeometry x="580" y="352" width="500" height="84" as="geometry"/></mxCell><mxCell id="c17" value="TOOL REGISTRY   (offered only if RBAC allows)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#82b366;strokeWidth=1.5;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontFamily=Helvetica;fontSize=12;fontSize=13;fontColor=#3c4043;" vertex="1" parent="1"><mxGeometry x="574" y="456" width="512" height="262" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;L1 Domain&lt;/b&gt;&lt;br&gt;VAT · ESUTD · compliance&lt;br&gt;cold chain · risk radar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="492" width="236" height="52" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;L2 Navigation&lt;/b&gt;&lt;br&gt;oeffneBereich, built from&lt;br&gt;modules.ts + area descriptions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;;fontSize=11;" vertex="1" parent="1"><mxGeometry x="834" y="492" width="236" height="52" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;L3 Data&lt;/b&gt;&lt;br&gt;datenmodellErkunden · datenLesen&lt;br&gt;schema auto-discovered" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="554" width="236" height="52" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;L4 Actions&lt;/b&gt; (7)&lt;br&gt;needsApproval, then the same&lt;br&gt;Server Action as the form" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;;fontSize=11;" vertex="1" parent="1"><mxGeometry x="834" y="554" width="236" height="52" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;L5 Client tools&lt;/b&gt;  schema only, executed in the browser&lt;br&gt;plus ohneAnsicht (escape hatch for small talk)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="616" width="480" height="44" as="geometry"/></mxCell><mxCell id="c23" value="&lt;i&gt;Self-adapting: new module = reachable · new table = readable · new action = one registry entry&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontFamily=Helvetica;fontSize=12;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="590" y="670" width="480" height="36" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Persist + audit&lt;/b&gt;&lt;br&gt;reply saved per user · one audit event per turn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;;" vertex="1" parent="1"><mxGeometry x="580" y="736" width="500" height="50" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;Claude Haiku 4.5 (cheapest model only)&lt;br&gt;tool calls streamed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;;" vertex="1" parent="1"><mxGeometry x="1160" y="140" width="380" height="78" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;ki_anbieter&lt;/b&gt;  (service role only)&lt;br&gt;API key AES-256-GCM encrypted&lt;br&gt;secret KI_ANBIETER_SCHLUESSEL in Vercel env" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;;" vertex="1" parent="1"><mxGeometry x="1160" y="246" width="380" height="88" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Supabase Postgres + RLS&lt;/b&gt;&lt;br&gt;every query runs with the USER session&lt;br&gt;customer: own rows · picker: own rows · finance: office only&lt;br&gt;denylist: keys, audit, chat history, queues" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;;" vertex="1" parent="1"><mxGeometry x="1160" y="362" width="380" height="112" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Server Actions&lt;/b&gt;  (same code as the forms)&lt;br&gt;requirePermission → validation → RLS write&lt;br&gt;→ audit event → revalidate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;;" vertex="1" parent="1"><mxGeometry x="1160" y="506" width="380" height="88" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;ki_chat_nachrichten&lt;/b&gt;&lt;br&gt;RLS: own rows · loader filters profile_id&lt;br&gt;office roles cannot read others' chats" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;;" vertex="1" parent="1"><mxGeometry x="1160" y="626" width="380" height="84" as="geometry"/></mxCell><mxCell id="c30" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.75;strokeColor=#3c4043;exitX=1;exitY=0.3;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#202124;" edge="1" parent="1" source="c8" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="241"/><mxPoint x="540" y="186"/></Array></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.75;strokeColor=#3c4043;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#202124;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value=