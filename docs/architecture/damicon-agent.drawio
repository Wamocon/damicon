onalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.75;strokeColor=#b85450;dashed=1;exitX=0.08;exitY=0.5;entryX=0.03;entryY=1;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;fontColor=#202124;" edge="1" parent="1" source="c12" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="51" y="656"/><mxPoint x="51" y="262"/></Array></mxGeometry></mxCell><mxCell id="c46" value="&lt;b&gt;Flow&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; question + mode, role, page, language  ·  &lt;b&gt;2&lt;/b&gt; prompt and tools to Claude, tool calls stream back  ·  &lt;b&gt;3&lt;/b&gt; agent calls a tool&lt;br&gt;&lt;b&gt;4&lt;/b&gt; reads run under the user's RLS session  ·  &lt;b&gt;5&lt;/b&gt; approved actions run through the Server Action  ·  &lt;b&gt;6&lt;/b&gt; client tool call streams to the browser&lt;br&gt;&lt;b&gt;7&lt;/b&gt; result returns by addToolOutput, the next round starts automatically  ·  &lt;b&gt;8&lt;/b&gt; persist and audit  ·  &lt;b&gt;9&lt;/b&gt; approval response goes with the next request  ·  &lt;b&gt;SSE&lt;/b&gt; answer streams back word by word" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontFamily=Helvetica;fontSize=12;fontSize=12;fontColor=#3c4043;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1520" height="70" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Security by absence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;a tool the role may not use is never offered&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fillColor=#ffffff;strokeColor=#9aa0a6;;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="292" height="60" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;RLS is the boundary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;the agent acts with the user's own session&lt;/font&gt;" 