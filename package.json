{
  "name": "damicon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-qr-scanner-worker.mjs",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:push": "supabase db push",
    "db:seed-auth": "node --env-file=.env.local supabase/seed-auth.mjs",
    "db:bestand": "node --env-file=.env.local supabase/testdaten.mjs --bestand",
    "db:testdaten": "node --env-file=.env.local supabase/testdaten.mjs",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "db:test": "node --env-file=.env.local supabase/tests/integration.mjs",
    "db:test:fast": "node supabase/tests/pglite-fast.mjs",
    "test:einladungen": "node supabase/tests/einladungen.mjs",
    "test:bereit": "node --env-file=.env.local scripts/einladung-bereit.mjs",
    "test:zukauf-parser": "node supabase/tests/zukauf-parser.mjs",
    "test:ausweis-scan": "node supabase/tests/ausweis-scan.mjs",
    "test:ki-assistent": "node supabase/tests/ki-assistent.mjs",
    "ki:anbieter": "node scripts/ki-anbieter-upsert.mjs",
    "test:agent": "npx --yes tsx supabase/tests/agent-abdeckung.ts",
    "test:wissen": "npx --yes tsx supabase/tests/wissen.ts",
    "test:haustier": "npx --yes tsx supabase/tests/haustier.ts",
    "wissen:einlesen": "npx --yes tsx scripts/wissen-ingest.ts",
    "wissen:frage": "npx --yes tsx scripts/wissen-frage.ts",
    "test:wetter": "node supabase/tests/wetter.mjs",
    "test:rechnungshistorie": "node supabase/tests/rechnungshistorie.mjs",
    "test": "npm run db:test:fast && npm run test:einladungen && npm run test:abnahme-2-7 && npm run test:abnahme-2-8 && npm run test:abnahme-2-10 && npm run test:abnahme-4-1 && npm run test:abnahme-4-7 && npm run test:zukauf-parser && npm run test:ausweis-scan && npm run test:ki-assistent && npm run test:agent && npm run test:kit && npm run test:finanz-zeitraum && npm run test:wissen && npm run test:wissen-backend && npm run test:pruefung && npm run test:tagesbericht && npm run test:uebersicht && npm run test:ausfall && npm run test:umlaute && npm run test:migrationen && npm run test:wetter && npm run test:rechnungshistorie && npm run test:abnahme-e-11 && npm run test:haustier",
    "test:abnahme-4-1": "node supabase/tests/abnahme-4-1.mjs",
    "test:abnahme-4-7": "node supabase/tests/abnahme-4-7.mjs",
    "test:abnahme-2-10": "node supabase/tests/abnahme-2-10.mjs",
    "test:abnahme-2-7": "node supabase/tests/abnahme-2-7.mjs",
    "test:abnahme-2-8": "node supabase/tests/abnahme-2-8.mjs",
    "test:abnahme-e-11": "node supabase/tests/abnahme-e-11.mjs",
    "test:migrationen": "node supabase/tests/migrationen-pruefung.mjs",
    "wissen:nach-supabase": "npx --yes tsx scripts/wissen-nach-supabase.ts",
    "db:migrationen-pruefen": "node scripts/pruefe-migrationen.mjs --basis origin/main",
    "test:wissen-backend": "npx --yes tsx supabase/tests/wissen-backend.ts",
    "test:wissen-db": "node --env-file=.env.local supabase/tests/wissen-pgvector.mjs",
    "test:pruefung": "npx --yes tsx supabase/tests/pruefung.ts",
    "test:kit": "npx --yes tsx supabase/tests/kit-bausteine.tsx",
    "test:finanz-zeitraum": "npx --yes tsx supabase/tests/finanz-zeitraum.ts",
    "test:ausfall": "npx --yes tsx supabase/tests/ausfall.ts",
    "test:umlaute": "npx --yes tsx supabase/tests/umlaute.ts",
    "test:tagesbericht": "npx --yes tsx supabase/tests/tagesbericht.ts",
    "test:uebersicht": "npx --yes tsx supabase/tests/uebersicht.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.57",
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@ai-sdk/react": "^4.0.109",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.113.0",
    "ai": "^7.0.106",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "gsplat": "^1.2.9",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.26",
    "lucide-react": "^0.469.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^2.6.1",
    "unified": "^11.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
