{
  "name": "damicon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-qr-scanner-worker.mjs",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "db:push": "supabase db push",
    "db:seed-auth": "node --env-file=.env.local supabase/seed-auth.mjs",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "db:test": "node --env-file=.env.local supabase/tests/integration.mjs",
    "db:test:fast": "node supabase/tests/pglite-fast.mjs",
    "test:einladungen": "node supabase/tests/einladungen.mjs",
    "test:bereit": "node --env-file=.env.local scripts/einladung-bereit.mjs",
    "test:zukauf-parser": "node supabase/tests/zukauf-parser.mjs",
    "test:ausweis-scan": "node supabase/tests/ausweis-scan.mjs",
    "test:ki-assistent": "node supabase/tests/ki-assistent.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.113.0",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "gsplat": "^1.2.9",
    "idb": "^8.0.3",
    "lenis": "^1.3.26",
    "lucide-react": "^0.469.0",
    "next": "16.2.1",
    "next-intl": "^4.14.2",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
